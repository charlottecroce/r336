// contae.r336 — the exiled shell.
//
// Reads its own data fine: exile-on-exile isn't a border crossing.
// Construction crosses freely too (a county locks the box, not the road),
// so this file builds `Imreoir` from primitives and passes it on. The loop
// is driven from exile but runs its body in place; `fógair` joins the
// vocabulary unqualified, like a loanword, dispatched via `déan … ar …`.
//
// Never opens `Imreoir` or `Foireann` here: exile can't treaty, so it
// can't. That's why `ainmDe` and `clúdach` live in the other file.

croí seasmhach = ó "./contae-croí.r336"

struchtúr Iontráil {
    ainm: Teaghrán
    aois: Uimhir
}

gníomh próiseáil(iontráil: Iontráil) {
    fógair Imreoir { ainm: ainm ó iontráil, aois: aois ó iontráil }
}

gníomh príomh() {
    amh seasmhach: Liosta(Iontráil) = [
        Iontráil { ainm: "Cáit", aois: 19 },
        Iontráil { ainm: "Séamus", aois: 34 }
    ]
    déan a phróiseáil ar amh
    scríobh clúdach(Foireann { ainm: "Na Piarsaigh" })
}