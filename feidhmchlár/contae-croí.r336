// contae-croí.r336 — the placed core. Two of the four provinces spent.
//
// Never touches JavaScript: `Iasacht` is exiled and exile trades with
// nobody, so this file is permanently cut off from the backend.
//
// WHY CORCAIGH. Ciarraí was the obvious county, but `Foireann` is in Baile
// Átha Cliath and Ciarraí/BÁC are old rivals: the treaty below would be
// E608 and `Foireann` could never be opened here. Corcaigh costs the same
// province either way, so it's the pick that doesn't also cost a treaty.

as Corcaigh

// Real work, not paperwork: without this, every line opening `Foireann`
// below is E601.
comhaontú Corcaigh Baile Átha Cliath

struchtúr Imreoir as Corcaigh {
    ainm: Teaghrán
    aois: Uimhir
}

struchtúr Foireann as Baile Átha Cliath {
    ainm: Teaghrán
}

feidhm ainmDe(imreoir: Imreoir) -> Teaghrán {
    ainm ó imreoir
}

feidhm óg(imreoir: Imreoir) -> Bool {
    aois ó imreoir < 21
}

// Opened via the treaty: Laighin on An Mhumhain.
feidhm clúdach(foireann: Foireann) -> Teaghrán {
    "Foireann: " + ainm ó fhoireann
}

gníomh fógair(imreoir: Imreoir) {
    scríobh ainmDe(imreoir)
}