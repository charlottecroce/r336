// sonraí.r336 — the data layer (§6). Knows nothing about SQLite; only talks
// to the R336 Stór abstraction, which owns the driver.
//
// Mood tracks the verb: `ceistigh` asks and answers (feidhm), `cuir` just
// commands (gníomh). Every DB op is ongoing (`ag`) until completed with
// `tar éis`, and that carries across the module boundary: bealaí.r336 sees
// `cuirDuine` as a gníomh, not a value.

stórlann seasmhach = ó "../rt/stór.js"

SCÉIM seasmhach = "CREATE TABLE IF NOT EXISTS daoine (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ainm TEXT NOT NULL,
    aois INTEGER NOT NULL
)"

ag feidhm oscailStór(conair: Teaghrán) -> Iasacht {
    tar éis oscail ó stórlann(conair)
}

ag gníomh cruthaighScéim(stór: Iasacht) {
    tar éis scéim ó stór(SCÉIM)
}

ag feidhm gachDuine(stór: Iasacht) -> Liosta(Iasacht) {
    tar éis ceistigh ó stór("SELECT id, ainm, aois FROM daoine ORDER BY ainm", [])
}

ag feidhm duineDeRéir(stór: Iasacht, aitheantas: Uimhir) -> Iasacht {
    rónna seasmhach: Liosta(Iasacht) = tar éis ceistigh ó stór("SELECT id, ainm, aois FROM daoine WHERE id = ?", [aitheantas])
    céad ó rónna
}

ag gníomh cuirDuine(stór: Iasacht, ainm: Teaghrán, aois: Uimhir) {
    tar éis feidhmigh ó stór("INSERT INTO daoine (ainm, aois) VALUES (?, ?)", [ainm, aois])
}