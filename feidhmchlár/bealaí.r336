// bealaí.r336 — route logic and registration (§4/§5), and the exiled shell
// (§0.7).
//
// Express and EJS stay as-is; R336 registers routes itself since 0.4, so
// JavaScript only does startup.
//
// From 0.4: `sealadach` (current state vs. permanent), `cuir … ar …`
// (mutation as a command, illegal in feidhm), `a <briathar>` (a verb as a
// noun, the only way to mention a command).
//
// From 0.5: `cuirDuine …` (a command across a module boundary), `déan … ar
// …` (distributing an action over a collection).
//
// NEW IN 0.7. This file stays exiled on purpose: that's what lets it talk
// to the outside world, since every `Iasacht` is exiled and exile-on-exile
// isn't a border crossing. So it reads row fields (`ainm ó thaifead`)
// freely, builds `Duine` from primitives freely (construction is never
// checked, a county locks the box not the road), and never opens `Duine`
// itself, which is why `ainmDe`/`aoisDe` live on the other side as accessors.

croí seasmhach     = ó "./duine.r336"
sonraí seasmhach   = ó "./sonraí.r336"
bun seasmhach      = ó "../rt/bunúsach.js"
freastal seasmhach = ó "../rt/freastal.js"

struchtúr AmharcLiosta {
    teideal: Teaghrán
    daoine: Liosta(Iasacht)
}

struchtúr AmharcDuine {
    teideal: Teaghrán
    duine: Iasacht
    aimsíodh: Bool
}

// No store exists until the app starts; `bí` tells us that.
stór sealadach: Iasacht = neamhní

// `Síol` struct is gone — it was a copy of `Duine` made because none
// existed yet. Built here in exile now.
daoine seasmhach: Liosta(Duine) = [
    Duine { ainm: "Charlotte", aois: 20 },
    Duine { ainm: "Séamus", aois: 12 },
    Duine { ainm: "Aoife", aois: 34 }
]

ag gníomh tosaigh(conair: Teaghrán) {
    cuir tar éis oscailStór ó shonraí(conair) ar stór
    síolaigh
}

// `ainm ó dhuine` here would be E601: this file is exiled, `Duine` is in An
// Mhumhain. Calls the two accessors instead.
ag gníomh cuirSíol(duine: Duine) {
    cuirDuine stór, ainmDe(duine), aoisDe(duine)
}

ag gníomh síolaigh() {
    cruthaighScéim stór
    rónna seasmhach: Liosta(Iasacht) = tar éis gachDuine ó shonraí(stór)
    má folamh ó rónna { déan a chuirSíol ar dhaoine }
    déan a chéim ar dhaoine
}

ag saor liostaigh(iarr: Iasacht, freag: Iasacht) {
    rónna seasmhach = tar éis gachDuine ó shonraí(stór)
    render ó fhreag("innéacs", AmharcLiosta {
        teideal: "Daoine",
        daoine: rónna
    })
}

ag saor taispeáin(iarr: Iasacht, freag: Iasacht) {
    // Keeps its borrowed name — we don't rename someone else's API.
    aitheantas seasmhach = uimhir ó bhun(id ó pharams ó iarr)
    más Uimhir aitheantas {
        taifead seasmhach = tar éis duineDeRéir ó shonraí(stór, aitheantas)
        render ó fhreag("duine", AmharcDuine {
            teideal: teideal(aimsigh(taifead)),
            duine: taifead,
            aimsíodh: tá taifead
        })
    } mura {
        status ó fhreag(400)
        send ó fhreag("Aitheantas neamhbhailí.")
    }
}

// `bí`: existence, not classification. Can't move this to the placed side:
// it takes `Iasacht`, since a missing row is `Iasacht`, and this is the
// conversion boundary the shell exists for. `Aimsiú`'s field can't be
// `Iasacht` (E213), so the conversion has to happen right here.
feidhm aimsigh(taifead: Iasacht) -> Aimsiú {
    má tá taifead {
        Aimsithe { duine: Duine { ainm: ainm ó thaifead, aois: aois ó thaifead } }
    } mura { Uireasa { } }
}

// `a liostaigh`/`a thaispeáin`: verb as noun, needed or E501. Both are
// autonomous verbs (§37) since Express calls them and R336 never does:
// registering them isn't a command, just an introduction to an agent that
// can't be named here.
gníomh cláraigh(app: Iasacht) {
    bealach ó fhreastal(app, "/", a liostaigh)
    bealach ó fhreastal(app, "/duine/:id", a thaispeáin)
}