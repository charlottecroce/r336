// bealaí.r336 — loighic agus clárú na mbealaí (Céim 4 agus 5), agus an bhlaosc
// ar deoraíocht (Céim 0.7).
//
// Fanann Express agus EJS mar atá. Ó chéim 0.4 i leith is i R336 a
// chláraítear na bealaí freisin, agus ní dhéanann JavaScript ach an tosú.
//
// Trí ghné a tháinig isteach i gcéim 0.4:
//
//   sealadach     staid an mhodúil: an rud atá ann faoi láthair, seachas an
//                 rud atá ann go buan
//   cuir … ar …   athrú staide mar ordú: ní féidir é a dhéanamh i bhfeidhm
//   a <briathar>  an briathar ina ainmfhocal, an t-aon slí a luaitear ordú
//
// Agus dhá cheann i gcéim 0.5:
//
//   cuirDuine …   ordú trasna teorann modúil
//   déan … ar …   an gníomh á dháileadh ar bhaill an bhailiúcháin
//
// AGUS AN CEANN NUA I GCÉIM 0.7. Tá an comhad seo ar deoraíocht agus fanfaidh
// sé ann. Sin an rud a ligeann dó labhairt leis an domhan lasmuigh: is
// deoraí gach `Iasacht`, agus ní teorainn í deoraíocht ar dheoraíocht. Trí
// riail a leanann as sin, agus is fiú iad a rá os ard mar níl aon cheann acu
// le feiceáil sa chód:
//
//   1. Léann an comhad seo réimsí de rónna (`ainm ó thaifead`) gan bhac. Is
//      deoraithe an dá thaobh.
//   2. Tógann sé `Duine` as bunchineálacha gan bhac. Ní sheiceáiltear tógáil:
//      is glas ar an mbosca é an cúige, ní teorainn ar an mbóthar.
//   3. Ní osclaíonn sé `Duine` uair ar bith, agus ní fhéadfadh. Sin an fáth a
//      bhfuil `ainmDe` agus `aoisDe` ann thall. Ní seirbhísigh iad: is iad an
//      trasnú.

croí seasmhach     = ó "./duine.r336"
sonraí seasmhach   = ó "./sonraí.r336"
bun seasmhach      = ó "../rt/bunúsach.js"
freastal seasmhach = ó "../rt/freastal.js"

struchtúr AmharcLiosta {
    teideal: Teaghrán
    daoine: Liosta(Iasacht)
}

struchtúr AmharcDuine {
    teideal: Teaghrán
    duine: Iasacht
    aimsíodh: Bool
}

// Níl aon stór ann go dtí go dtosaítear an feidhmchlár, agus sin an rud a
// insíonn "bí" dúinn.
stór sealadach: Iasacht = neamhní

// D'imigh `struchtúr Síol`. Ba chóip de `Duine` é a bhí ann toisc nach raibh
// aon `Duine` ann le cóipeáil. Anois tá, agus tógtar é anseo sa deoraíocht.
daoine seasmhach: Liosta(Duine) = [
    Duine { ainm: "Charlotte", aois: 20 },
    Duine { ainm: "Séamus", aois: 12 },
    Duine { ainm: "Aoife", aois: 34 }
]

ag gníomh tosaigh(conair: Teaghrán) {
    cuir tar éis oscailStór ó shonraí(conair) ar stór
    síolaigh
}

// SEO AN NÓIMÉAD. Ba é `ainm ó dhuine` a bheadh anseo dá mbeadh cead aige, agus
// is E601 é: tá an comhad seo ar deoraíocht agus tá `Duine` in An Mhumhain.
// Glaotar ar an dá bhriathar thall ina áit. Dhá líne bhreise atá i gceist, agus
// tá an chuma orthu gur trasnú soiléir atá ann seachas cáin — ach féach §25.9:
// níl ach dhá réimse sa chineál seo, agus scéal eile a bheadh ann le deich gcinn.
ag gníomh cuirSíol(duine: Duine) {
    cuirDuine stór, ainmDe(duine), aoisDe(duine)
}

ag gníomh síolaigh() {
    cruthaighScéim stór
    rónna seasmhach: Liosta(Iasacht) = tar éis gachDuine ó shonraí(stór)
    má folamh ó rónna { déan a chuirSíol ar dhaoine }
    // An lúb á tiomáint as an deoraíocht, an corp á rith san áit. `céim` a
    // tháinig ó "./duine.r336" agus níl cáiliú ar bith air.
    déan a chéim ar dhaoine
}

ag saor liostaigh(iarr: Iasacht, freag: Iasacht) {
    rónna seasmhach = tar éis gachDuine ó shonraí(stór)
    render ó fhreag("innéacs", AmharcLiosta {
        teideal: "Daoine",
        daoine: rónna
    })
}

ag saor taispeáin(iarr: Iasacht, freag: Iasacht) {
    // Coinníonn ball ar iasacht a ainm iasachta: ní aistrímid API duine eile.
    aitheantas seasmhach = uimhir ó bhun(id ó pharams ó iarr)
    // `is` mar aicmiú: an uimhir í an rud a tháinig isteach? Ní uimhir é NaN.
    más Uimhir aitheantas {
        taifead seasmhach = tar éis duineDeRéir ó shonraí(stór, aitheantas)
        render ó fhreag("duine", AmharcDuine {
            teideal: teideal(aimsigh(taifead)),
            duine: taifead,
            aimsíodh: tá taifead
        })
    } mura {
        status ó fhreag(400)
        send ó fhreag("Aitheantas neamhbhailí.")
    }
}

// `bí` mar cheist bheithe, ní mar aicmiú: an bhfuil aon rud ann?
//
// Ní féidir an fheidhm seo a chur thall, agus is é sin an rud is suimiúla a
// tharla sa chéim seo. Glacann sí le `Iasacht`, mar is `Iasacht` é rón nach
// bhfuil ann. Níl aon chineál suime sa teanga fós (§22), mar sin is é
// `Iasacht` an tslí a chuirtear "b'fhéidir nach bhfuil sé ann" in iúl, agus
// tá `Iasacht` ar deoraíocht. Titeann an teorainn idir curtha agus deoraithe
// go díreach san áit a bhfuil na cineálacha suime ar iarraidh.
// Níl fágtha anseo ach an tiontú, agus is é sin obair na blaoisce ó thús: an
// saol amuigh a léamh agus luach curtha a thógáil as (§24.3). D'imigh an
// loighic — cad is teideal ann — go dtí `duine.r336`, mar a bhfuil an cineál.
//
// Ní fhéadfadh an tiontú seo bogadh anonn, agus is riail é sin seachas
// timpiste: chuirfeadh E213 cosc ar `Iasacht` i réimse malairte, mar sin
// caithfidh an tiontú tarlú ar an teorainn. Sin an rud a bhí uainn.
feidhm aimsigh(taifead: Iasacht) -> Aimsiú {
    má tá taifead {
        Aimsithe { duine: Duine { ainm: ainm ó thaifead, aois: aois ó thaifead } }
    } mura { Uireasa { } }
}

// `a liostaigh`, `a thaispeáin`: an briathar mar ainmfhocal. Gan an cháithnín
// seo bheadh E501 ann — ní ainmní é ordú.
//
// Ó 0.10 is briathra saora iad an dá cheann (§37), agus sin an rud ceart:
// glaonn Express orthu, agus ní ghlaonn R336 orthu riamh. Ní ordú é
// `bealach ó fhreastal(…)` a thugtar dóibh ach clárú — cuirtear in aithne
// don saol lasmuigh iad, agus déantar iad ansin, ag déantóir nach féidir a
// ainmniú anseo.
//
// Tá dhá rud á bhforfheidhmiú anois nach raibh: ní féidir `liostaigh iarr,
// freag` a scríobh in aon áit sa mhodúl seo (E518), agus ní féidir ceachtar
// acu a thabhairt do bhriathar R336 ar bith, mar dhéanfadh sin déantóir
// de. Níl ach `Iasacht` fágtha mar cheann scríbe, agus is í an teorainn í.
gníomh cláraigh(app: Iasacht) {
    bealach ó fhreastal(app, "/", a liostaigh)
    bealach ó fhreastal(app, "/duine/:id", a thaispeáin)
}
