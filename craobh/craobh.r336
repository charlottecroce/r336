// craobh.r336 — an bhlaosc, ar deoraíocht.
//
// Tógann sí gach rud agus ní osclaíonn sí aon rud. Sin an patrún céanna a bhí
// ag `bealaí.r336` i gcéim 0.7: is glas ar an mbosca é contae, ní teorainn ar an
// mbóthar, mar sin téann luachanna áit ar bith.

imr seasmhach = ó "./imreoir.r336"
fir seasmhach = ó "./foireann.r336"
clu seasmhach = ó "./cluiche.r336"
tor seasmhach = ó "./toradh.r336"

ciarraí seasmhach = Foireann {
    ainm: "Ciarraí",
    imreoirí: [Imreoir { ainm: "Ó Sé", scór: 12 }]
}

gaillimh seasmhach = Foireann {
    ainm: "Gaillimh",
    imreoirí: [Imreoir { ainm: "Ó Curraoin", scór: 9 }]
}

cluichí seasmhach: Liosta(Cluiche) = [
    Cluiche { baile: ciarraí, cuairt: gaillimh },
    Cluiche { baile: gaillimh, cuairt: gaillimh }
]

gníomh craol(c: Cluiche) {
    scríobh tuairisc(toradhCluiche(c))
}

gníomh príomh() {
    déan a chraol ar chluichí
}
