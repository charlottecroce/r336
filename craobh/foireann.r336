as Baile Átha Cliath

imr seasmhach = ó "./imreoir.sb"

// Tá `Imreoir` as Ciarraí agus tá an comhad seo as Baile Átha Cliath, agus is
// seanaighneas atá eatarthu. Ní féidir conradh a dhéanamh (E608) agus ní
// chabhraíonn an cúige (E609). Mar sin coinníonn `Foireann` a cuid imreoirí
// agus ní féidir léi ceann acu a oscailt choíche. Ní locht é sin — is é sin an
// cinneadh a rinneadh nuair a roghnaíodh na contaetha.
struchtúr Foireann as Baile Átha Cliath {
    ainm: Teaghrán
    imreoirí: Liosta(Imreoir)
}

feidhm ainmFoirne(f: Foireann) -> Teaghrán { ainm ó fh }
feidhm painéal(f: Foireann) -> Liosta(Imreoir) { imreoirí ó fh }
