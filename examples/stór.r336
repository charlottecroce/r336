// stór.r336 — the exiled shell (§41).
//
// Opens the store and creates the schema here, not in the core: the store
// abstraction is `Iasacht`, `Iasacht` is exiled, and a placed file can't
// read a member off exile (E601). Same split as in feidhmchlár/ since 0.6.
//
// What changed: the shell no longer has to convert `Iasacht` to a type
// itself. `faigh` only needs the store value as an argument, and passing
// an argument isn't a member read.

stórlann seasmhach = ó "../rt/stór.js"
croí seasmhach = ó "./stór-croí.r336"

// The compiler doesn't generate a schema from fields (§41.4): that would
// need a type-to-column-type table, a second language's vocabulary this
// project isn't taking on.
SCÉIM seasmhach = "CREATE TABLE IF NOT EXISTS duine (
    ainm TEXT NOT NULL,
    aois INTEGER NOT NULL
)"

ag gníomh príomh() {
    stór seasmhach = tar éis oscail ó stórlann(":memory:")
    tar éis scéim ó stór(SCÉIM)
    tar éis feidhmigh ó stór("INSERT INTO duine (ainm, aois) VALUES (?, ?), (?, ?)", ["Cáit", 20, "Oisín", 34])

    // "liostaigh" unqualified: came from stór-croí.r336, and verbs join
    // the vocabulary unqualified.
    liostaigh stór

    tar éis dún ó stór()
}