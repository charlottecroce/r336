// copail.r336 — `is` vs `bí`, and the copula's paradigm (§13, §14, §31).
//
//   is  — identity/classification: what is it?
//   bí  — existence/state: is it there?
//
// Since 0.9 the copula also has form, fusing with its governing particle
// like real Irish: is → más under má, → mura/murab under mura (murab
// before a vowel). Meaning never changes across forms, same as tá/bhfuil
// for bí.

struchtúr Duine {
    ainm: Teaghrán
}

duine seasmhach = Duine { ainm: "Charlotte" }

// Under a particle: má + is fuse into one word, predicate before subject.
más Duine duine {
    scríobh "Is duine é: " + ainm ó dhuine
}

// Ungoverned: the independent form, a Bool expression.
isDuine seasmhach = duine is Duine
scríobh isDuine

má tá duine {
    scríobh "Tá duine ann."
} mura {
    scríobh "Níl duine ar bith ann."
}

// Classifying a primitive value.
aois seasmhach = 20
más Uimhir aois {
    scríobh "Is uimhir í an aois."
}

// Two allomorphs: the type name's first letter picks mura vs murab;
// morphology decides, the analyzer just asks.
struchtúr Áit {
    logainm: Teaghrán
}

áit seasmhach = Áit { logainm: "Cill Chainnigh" }

// Don't put these two back to back: a bare "mura" after a block reads as
// another branch (§17) and would swallow the next one. That's the
// particle's doing, not the copula's — true before 0.9 too.
feidhm ganDuine(a: Áit) -> Teaghrán {
    mura Duine a { "Ní duine í an áit." } mura { "?" }
}

feidhm ganAit(d: Duine) -> Teaghrán {
    murab Áit d { "Ní háit é an duine." } mura { "?" }
}

scríobh ganDuine(áit)
scríobh ganAit(duine)