// suim.sb — cineálacha suime (§26).
//
// Trí rud atá le feiceáil anseo, agus is ceann amháin acu Gaeilge.
//
//   TABHAIRT ISTEACH   `Ceart { duine: … }`. Déantús struchtúir atá ann, gan
//                      chomhréir nua ar bith. Is leathnú saor é: is Toradh
//                      cheana féin é Ceart, agus ní gá aon rud a thiontú.
//
//   DÍOTHÚ             `más Ceart t`. Seo an leath atá bunaithe ar an
//                      nGaeilge: aicmíonn an chopail, agus nuair a chuirtear
//                      an cheist tá an freagra ar eolas chomh fada is a
//                      mhaireann an chraobh.
//
//   AN CÚIGE           Éilíonn an tsuim cúige; ní éilíonn malairt ar bith.
//                      Sin an chúis nach n-itheann suim dhá shliotán.

as Corcaigh

struchtúr Duine as Corcaigh {
    ainm: Teaghrán
    aois: Uimhir
}

// Tá an tsuim i gConnachta agus tá `Duine` san Mhumhain, mar sin teastaíonn
// conradh chun ualach na malairte a oscailt. Cineál curtha é an t-ualach fós:
// ní athraíonn an tsuim é sin.
comhaontú Corcaigh Gaillimh

suim Toradh as Gaillimh {
    Ceart  { duine: Duine }
    Easpa  { cúis: Teaghrán }
}

// `Neamhní` a chuireann easpa in iúl anois, ní `Iasacht`. Is E213 é `Iasacht`
// i réimse malairte: dearbhaíonn suim cad is féidir le luach a bheith, agus
// ní catagóir í an Iasacht (§26.4).
feidhm tuairisc(toradh: Toradh) -> Teaghrán {
    más Ceart toradh { ainm ó dhuine ó thoradh } mura { cúis ó thoradh }
}

// Buaileann an dá chraobh le chéile ag an tsuim. Ní teip chineáil é craobh
// amháin a thabhairt `Ceart` agus an ceann eile `Easpa`.
feidhm cuardaigh(aois: Uimhir) -> Toradh {
    má aois > 17 { Ceart { duine: Duine { ainm: "Cáit", aois: aois } } }
    mura { Easpa { cúis: "Ró-óg" } }
}

// Tá áit ag liosta ilchineálach le dul anois, agus sin an rud a fhágann go
// bhfuil E211 sroichte faoi dheireadh (§26.5).
seasmhach torthaí: Liosta(Toradh) = [
    Ceart { duine: Duine { ainm: "Síle", aois: 30 } },
    Easpa { cúis: "Gan aimsiú" }
]

gníomh luaigh(toradh: Toradh) {
    scríobh tuairisc(toradh)
}

gníomh príomh() {
    déan a luaigh ar thorthaí
    scríobh tuairisc(cuardaigh(20))
    scríobh tuairisc(cuardaigh(9))
}
