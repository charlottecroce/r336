// saor.r336 — the autonomous verb, the third mood (§37).
//
//   feidhm  — states, returns a value (indicative)
//   gníomh  — does, addresses an agent (imperative)
//   saor    — done, with no nameable agent (autonomous)
//
// Not a passive: it's not that the agent is omitted, it's that none can be
// named. That's the whole distinction the compiler enforces.

// The declaration uses the root (imperative form): "liostaigh".
saor liostaigh(mír: Teaghrán) {
    scríobh "· " + mír
}

saor fógair(teachtaireacht: Teaghrán) {
    scríobh "! " + teachtaireacht
}

// Usage writes the derived autonomous form, not the root: liostaigh ->
// liostaítear, fógair -> fógraítear (syncopating). Writing "liostaigh mír"
// as a command is E518 — there's nobody to command.
gníomh príomh() {
    liostaítear "arán"
    liostaítear "im"
    fógraítear "tá an liosta déanta"
}