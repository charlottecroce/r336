// príomh.r336 — the importing module (§19).
//
// A borrowed verb joins the vocabulary unqualified, like a loanword in
// Irish: nobody says "the borrowed verb X," they just say X. So
// `fáiltigh "Cáit"` is an ordinary command.
//
// The module is still a possessor and `ó` is the same relation as always,
// just with a better-recognised possessor now.

foclóir seasmhach = ó "./foclóir.r336"

gníomh príomh() {
    // a value member, through possession
    scríobh BEANNACHT ó fhoclóir

    // a borrowed feidhm: callable unqualified or through the possessor
    scríobh beannaigh("Cáit")
    scríobh beannaigh ó fhoclóir("Oisín")

    // a borrowed gníomh: it's a command, given as one
    fáiltigh "Aoife"
}