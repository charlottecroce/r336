// cineálBriathair.sb — cineál an bhriathair (DEARADH.md §20).
//
// Is é cineál briathair a fhógra gan an t-ainm, mar sin is é an modh cuid den
// chineál: is rud eile ar fad é `gníomh(T)` agus `feidhm(T) -> U`. Ní bhratach
// ar chineál amháin é an modh; is airí foclóireachta den bhriathar é (§17),
// agus mar sin baineann sé lena chineál.
//
//     feidhm(Uimhir) -> Uimhir      táscach: tugann sé ainmní
//     gníomh(Teaghrán)              ordaitheach: ní thugann sé faic
//     ag feidhm(Iasacht) -> Bool    ar siúl
//
// Ní féidir gníomh a ghlaoch mar shlonn (E501), agus mar sin níl ach aon
// tomhaltóir amháin ag luach de chineál `gníomh`: `déan`. Sin an freagra
// ceart — is ainmfhocal é ordú ainmnithe, agus is é `déan` an tslí a
// dhéantar gníomh de arís.

gníomh fógair(t: Teaghrán) { scríobh t }

gníomh faoiDhó(g: gníomh(Teaghrán), liosta: Liosta(Teaghrán)) {
    déan g ar liosta
    déan g ar liosta
}

feidhm dúbail(u: Uimhir) -> Uimhir { u + u }

feidhm cuirIbhFeidhm(f: feidhm(Uimhir) -> Uimhir, u: Uimhir) -> Uimhir {
    f(u)
}

gníomh príomh() {
    faoiDhó a fhógair, ["a", "b"]
    scríobh cuirIbhFeidhm(a dhúbail, 21)
}
