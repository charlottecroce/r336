// aspect.r336 — the verbal noun as promise, modeling async (§18).
//
// Irish has no present continuous; the action becomes a noun placed in a
// state of being: "Tá sé ag scríobh" (ongoing, a promise) vs. "Tá sé tar
// éis scríobh" (completed, a value).
//
//     ag feidhm f() -> T     calling f returns an ongoing action
//     tar éis f()            completes it, yields T
//
// An ongoing action isn't a value yet: E505 without `tar éis`, E504 if
// `tar éis` is used where the verb isn't `ag`.

stórlann seasmhach = ó "../rt/stór.js"

ag feidhm ainmneacha(stór: Iasacht) -> Liosta(Iasacht) {
    tar éis ceistigh ó stór("SELECT ainm FROM daoine ORDER BY ainm", [])
}

ag gníomh príomh() {
    stór seasmhach = tar éis oscail ó stórlann(":memory:")
    tar éis scéim ó stór("CREATE TABLE daoine (ainm TEXT)")
    tar éis feidhmigh ó stór("INSERT INTO daoine (ainm) VALUES (?), (?)", ["Cáit", "Oisín"])

    rónna seasmhach: Liosta(Iasacht) = tar éis ainmneacha(stór)
    scríobh "líon: " + comhaireamh(fad ó rónna)
    scríobh "an chéad cheann: " + ainm ó chéad ó rónna

    tar éis dún ó stór()
}

feidhm comhaireamh(u: Uimhir) -> Teaghrán {
    má u == 0 { "náid" } mura { má u == 1 { "aon" } mura { "roinnt" } }
}