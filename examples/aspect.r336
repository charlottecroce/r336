// aspect.sb — an aidiacht bhriathartha mar mhúnla comhthreomhaireachta (§18).
//
// Níl aimsir láithreach leanúnach ag an nGaeilge. Ina háit sin cuirtear an
// gníomh in ainmfhocal agus suitear i staid bheithe é:
//
//     Tá sé ag scríobh.        an gníomh ar siúl   → gealltanas
//     Tá sé tar éis scríobh.   an gníomh curtha i gcrích → luach
//
// Sin go díreach an rud is gealltanas ann: gníomh atá déanta ina rud is
// féidir a choinneáil. Mar sin:
//
//     ag feidhm f() -> T     tugann glaoch ar f gníomh ar siúl ar ais
//     tar éis f()            críochnaíonn sé, agus tagann T as
//
// Ní luach é gníomh atá ar siúl go fóill: E505 má bhaintear úsáid as gan
// "tar éis". Agus ní féidir rud a chríochnú mura bhfuil sé ar siúl: E504 má
// úsáidtear "tar éis" gan "ag" ar an bhfógra.

stórlann seasmhach = ó "../rt/stór.js"

ag feidhm ainmneacha(stór: Iasacht) -> Liosta(Iasacht) {
    tar éis ceistigh ó stór("SELECT ainm FROM daoine ORDER BY ainm", [])
}

ag gníomh príomh() {
    stór seasmhach = tar éis oscail ó stórlann(":memory:")
    tar éis scéim ó stór("CREATE TABLE daoine (ainm TEXT)")
    tar éis feidhmigh ó stór("INSERT INTO daoine (ainm) VALUES (?), (?)", ["Cáit", "Oisín"])

    rónna seasmhach: Liosta(Iasacht) = tar éis ainmneacha(stór)
    scríobh "líon: " + comhaireamh(fad ó rónna)
    // `céad` inséimhithe ina dhiaidh sin: "ainm ó chéad ó rónna".
    scríobh "an chéad cheann: " + ainm ó chéad ó rónna

    tar éis dún ó stór()
}

feidhm comhaireamh(u: Uimhir) -> Teaghrán {
    má u == 0 { "náid" } mura { má u == 1 { "aon" } mura { "roinnt" } }
}
