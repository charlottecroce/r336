// stór-croí.r336 — the placed core (§41).
//
// This file and `Duine` are both from Corcaigh, so fields can be read;
// same rule as always.
//
// What's new: rows arrive already typed as `Duine`, instead of the shell
// hand-converting from `Iasacht` (see `aimsigh` in bealaí.r336). The core
// still doesn't talk to the database directly, it just takes the store as
// an opaque argument.
//
// `as`, not `ó`, because this isn't possession — the row doesn't come from
// the store the way a name comes from a person.

as Corcaigh

// Name, adjective, engineering marker, provenance — fixed order.
struchtúr Duine firinscneach stór as Corcaigh {
    ainm: Teaghrán
    aois: Uimhir
}

// Table is "duine", not "daoine": pluralization is suppletive and no rule
// reaches it, so the compiler never guesses.
ag gníomh liostaigh(stór: Iasacht) {
    daoine seasmhach: Liosta(Duine) = tar éis faigh Duine as stór
    déan a bheannaigh ar dhaoine
}

// "aois" isn't read here but is still a column: the declared field list is
// the column list, nowhere else to write it.
gníomh beannaigh(duine: Duine) {
    scríobh "Dia duit, " + ainm ó dhuine
    scríobh aois ó dhuine
}