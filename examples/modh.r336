// modh.r336 — imperative vs indicative mood (§17).
//
// The verb root is the Irish imperative: "scríobh!", "déan!". A command is
// obeyed, not named, which is why R336 commands take no parens and can't
// be used as expressions.
//
//   feidhm  — states a thing, returns a value
//   gníomh  — does a thing, returns nothing

struchtúr Duine {
    ainm: Teaghrán
    aois: Uimhir
}

// Indicative: computes a value, does nothing.
feidhm céim ó Dhuine(féin) -> Teaghrán {
    má aois ó fhéin >= 18 { "aosta" } mura { "óg" }
}

// Imperative: no return value, given as a command.
gníomh fógair(duine: Duine) {
    scríobh "── " + ainm ó dhuine
    scríobh "   céim: " + céim ó dhuine()
}

fógair Duine { ainm: "Charlotte", aois: 20 }
fógair Duine { ainm: "Séamus", aois: 12 }

// Lists: "fad ó dhaoine" is the same possessive relation on a built-in type.
daoine seasmhach = [
    Duine { ainm: "Charlotte", aois: 20 },
    Duine { ainm: "Séamus", aois: 12 }
]

scríobh "líon: " + comhaireamh(fad ó dhaoine)
scríobh "folamh: " + comhaireamh(fad ó [])

feidhm comhaireamh(u: Uimhir) -> Teaghrán {
    má u == 0 { "náid" } mura { má u == 1 { "aon" } mura { "roinnt" } }
}