// seilbh.r336 — chained possession: each `ó` governs the head of its own
// complement, like a preposition in Irish.

struchtúr Seoladh {
    baile: Teaghrán
    uimhir: Uimhir
}

struchtúr Duine {
    ainm: Teaghrán
    seoladh: Seoladh
}

duine seasmhach = Duine {
    ainm: "Cáit",
    seoladh: Seoladh { baile: "Corcaigh", uimhir: 14 }
}

// duine -> dhuine, seoladh -> sheoladh; baile heads the whole phrase so it
// stays base form.
scríobh baile ó sheoladh ó dhuine
scríobh uimhir ó sheoladh ó dhuine

// Vowel-initial identifiers have no lenition slot, so the base form is
// correct after "ó".
áit seasmhach = Seoladh { baile: "Gaillimh", uimhir: 3 }
scríobh baile ó áit