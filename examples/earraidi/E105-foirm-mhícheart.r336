// E105 — form doesn't match any valid paradigm.
//
// A narrow leftover case. "DHuine" looks lenited (leniting consonant + h),
// and "Duine" is bound, but lenition keeps case on the radical and adds a
// lowercase h: the real lenited form is "Dhuine", not "DHuine". Wrong for
// the word, not just the position, hence E105 rather than E102/E103.

struchtúr Taifead {
    ainm: Teaghrán
}

Duine seasmhach = Taifead { ainm: "Cáit" }

gníomh príomh() {
    scríobh ainm ó DHuine
}