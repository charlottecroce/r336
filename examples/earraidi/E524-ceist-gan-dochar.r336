// E524 — asking about an affliction no verb ever declared.
//
// `bréagach` isn't the answer: answering at all would mean the question
// could be asked about anything, making the `-> Uimhir ar Earráid`
// signature meaningless. The declaration is what creates the question.
// Same pattern as E302.

struchtúr Earráid {
    cúis: Teaghrán
}

comhaireamh seasmhach = 3

gníomh luaigh() {
    má tá Earráid ar chomhaireamh {
        scríobh "buailte"
    }
}