// E611 — this type has no table.
//
// `Duine` was never declared `stór`, so there's nothing to read.
//
// A refusal, not an empty list: returning `Liosta(Duine)` empty would make
// the question always answerable, which would make the declaration mean
// nothing. Same shape as E302 and E524.

struchtúr Duine {
    ainm: Teaghrán
    aois: Uimhir
}

ag feidhm gach(stór: Iasacht) -> Liosta(Duine) {
    tar éis faigh Duine as stór
}