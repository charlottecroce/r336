// E507 — unterminated "má" chain.
//
// As an expression, every path must produce a value, which needs a bare
// "mura" branch — Irish has no word for "else", only the chain's final
// unconditional branch (§17).

feidhm rang(aois: Uimhir) -> Teaghrán {
    ainm seasmhach = má aois > 65 { "sinsear" } mura aois > 17 { "duine fásta" }
    ainm
}