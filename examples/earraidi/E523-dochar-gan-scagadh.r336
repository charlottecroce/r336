// E523 — an afflicted value used before the affliction is ruled out.
//
// The whole protection, and it only applies where a verb declared it: the
// caller only has to rule out the one thing named, not every possible case.
//
// Fix: `má tá Earráid ar thoradh { … } mura { … }`. The negative branch
// narrows to a plain Uimhir.

struchtúr Earráid {
    cúis: Teaghrán
}

feidhm roinn(uachtar: Uimhir, íochtar: Uimhir) -> Uimhir ar Earráid {
    má íochtar == 0 { Earráid { cúis: "nialas" } } mura { uachtar / íochtar }
}

leath seasmhach: Uimhir = roinn(10, 2)