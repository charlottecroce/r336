// E612 — this county's table is already taken.
//
// A table claims a county, not a whole province, unlike an ordinary placed
// type. But the two claims still collide: a table in Corcaigh blocks any
// ordinary type from claiming An Mhumhain, and vice versa, so `stór` isn't
// a backdoor around E603.
//
// Ceiling is 32, reachable only in a program with no ordinary placed types.

struchtúr Duine stór as Corcaigh {
    ainm: Teaghrán
}

struchtúr Áit stór as Corcaigh {
    ainm: Teaghrán
}