// E522 — an affliction on something with no result.
//
// Misfortune strikes something ("tá tinneas cinn orm"). A gníomh returns
// nothing, so there's nothing to strike.
//
// Different from E404: E404 says gníomh can't declare a result type at
// all; this says the "ar" clause needs a result to attach to. Both fixed
// by adding "->".

struchtúr Earráid {
    cúis: Teaghrán
}

gníomh fógair(x: Uimhir) ar Earráid {
    scríobh x
}