// E517 — wrong copula form.
//
// Three ways to trigger it, all the same fault: the copula wasn't fused
// with its governing particle. Same story as E512 — meaning never changes,
// only form.

suim Toradh as Corcaigh {
    Ceart  { luach: Uimhir }
    Easpa  { cúis: Teaghrán }
}

t seasmhach: Toradh = Ceart { luach: 1 }

// 1. Old word order: má and is written separately, but Irish fuses them:
//    má + is = más.
feidhm a() -> Uimhir {
    má t is Ceart { 1 } mura { 0 }
}

// 2. Wrong allomorph: Easpa starts with a vowel, so murab is needed.
feidhm b() -> Uimhir {
    mura Easpa t { 1 } mura { 0 }
}

// 3. A fused particle with nothing to classify: más means "má is" and
//    promises a classification that isn't there.
feidhm c() -> Uimhir {
    más 1 > 0 { 1 } mura { 0 }
}