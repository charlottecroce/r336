// E302 — a classification that can never be true.
//
// A sum is a closed statement of what a value can be, so "is this Toradh
// an Alt?" can be answered at compile time when Alt isn't one of its
// variants.

suim Toradh {
    Ceart { luach: Uimhir }
    Easpa { cúis: Teaghrán }
}

suim Teachtaireacht {
    Alt   { téacs: Teaghrán }
    Beart { méid: Uimhir }
}

feidhm mícheart(t: Toradh) -> Bool {
    t is Alt
}