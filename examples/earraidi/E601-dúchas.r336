// E601 — provenance: a box from another province, unopened.
//
// The province is the border, not the county: Corcaigh (An Mhumhain) and
// Gaillimh (Connachta) are different provinces with no treaty here.
//
// Declaring is fine from any province; only opening (reading a field) is
// checked.

as Corcaigh

struchtúr Duine as Gaillimh {
    ainm: Teaghrán
}

feidhm ainmDe(duine: Duine) -> Teaghrán {
    ainm ó dhuine
}