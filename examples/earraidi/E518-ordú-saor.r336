// E518 — an autonomous verb can't be commanded.
//
// Mirror of E501: E501 says a gníomh can't be mentioned (it's done, not
// named); E518 says an autonomous verb can't be commanded (it's named, not
// done) — there's no agent for the imperative to address.

saor liostaigh(mír: Teaghrán) {
    scríobh mír
}

gníomh príomh() {
    liostaigh "arán"
}