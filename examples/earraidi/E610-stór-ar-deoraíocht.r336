// E610 — table with no place: this type has no county.
//
// Exile isn't a place. A table is somewhere, so an unplaced type can't
// have one.
//
// Not an arbitrary restriction: without it, table count would be
// unbounded and "stór" would mean nothing. As is, tables cap at four per
// program, since each ordinary placed type spends a whole province (E603).

struchtúr Duine stór {
    ainm: Teaghrán
    aois: Uimhir
}