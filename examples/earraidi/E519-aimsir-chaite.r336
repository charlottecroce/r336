// E519 — wrong form of the autonomous verb.
//
// `liostaíodh` is real Irish (past autonomous), but R336 has no tense, so
// there's no slot for it. Recognised on purpose so it can be refused by
// name rather than reported as "unbound identifier".

saor liostaigh(mír: Teaghrán) {
    scríobh mír
}

gníomh príomh() {
    liostaíodh "arán"
}