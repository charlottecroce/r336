// E509 — a method declared on a non-struct.
//
// A method is a possession: the receiver holds it like a struct holds a
// field. A sum holds nothing until narrowed, and a variant never holds
// anything, it just names a shape.

suim Toradh {
    Ceart { luach: Uimhir }
    Easpa { cúis: Teaghrán }
}

feidhm cuntas ó Thoradh(féin) -> Uimhir {
    1
}