// E513 — "a" before something that isn't a verb.
//
// `a` nominalises a verb: `a fhógair` names the command as a noun. A
// number already has a name, so there's nothing for `a` to do.
//
// `a` isn't a keyword: `seasmhach a = 3` still works. Two bare identifiers
// side by side is what triggers this, not a lookup table.

uimhir seasmhach = 3

gníomh príomh() {
    scríobh a uimhir
}