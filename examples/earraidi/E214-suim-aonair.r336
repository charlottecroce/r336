// E214 — a sum needs at least two variants.
//
// Two cases, one code. Empty has no value at all. Single-variant has only
// one possible value, so `más` on it is ceremony, not a real choice.
// Either way there's no choice between categories, which is the whole
// point of a sum.

// Empty.
suim Folamh as Corcaigh {
}

// Single variant.
suim Aonair as Gaillimh {
    Amháin { luach: Uimhir }
}