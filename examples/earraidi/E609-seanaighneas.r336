// E609 — old rivalry: not opened even within the same province.
//
// Corcaigh and Ciarraí share a province, so ordinarily there'd be no
// border. But they're rivals, so the box stays shut regardless of any
// treaty — the veto overrides all four border cases, not just one.

as Ciarraí

struchtúr Duine as Corcaigh {
    ainm: Teaghrán
}

feidhm ainmDe(duine: Duine) -> Teaghrán {
    ainm ó dhuine
}