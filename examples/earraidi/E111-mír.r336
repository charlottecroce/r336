// E111 — wrong form of the preposition "i".
//
// The following word picks the form, not the writer: "i" + eclipsis
// before a consonant, "in" + base form before a vowel. Same rule as
// más/murab (§5.2), applied to a preposition. "áit" starts with a vowel,
// so "in áit" is correct.

as Corcaigh

struchtúr Duine stór as Corcaigh {
    ainm: Teaghrán
}

ag gníomh cláraigh(áit: Iasacht, duine: Duine) {
    cuir duine i áit
}