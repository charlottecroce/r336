// E204 — réimsí ar iarraidh sa struchtúr.
//
// Ní ghlactar le taifead neamhiomlán. Ní hionann struchtúr agus mála: dearbhú
// atá ann faoi na rudaí atá i luach, agus caithfidh siad ar fad a bheith ann.

struchtúr Duine {
    ainm: Teaghrán
    aois: Uimhir
}

duine seasmhach = Duine { ainm: "Cáit" }
