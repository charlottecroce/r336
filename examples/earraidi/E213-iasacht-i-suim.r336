// E213 — Iasacht isn't a category.
//
// A sum declares exactly what a value can be; `Iasacht` means "unknown
// category," which can't be one of the choices. `Iasacht` is still fine on
// a struct field, since a record never claimed to enumerate anything.

suim Ceist {
    Freagra { rón: Iasacht }
    Folamh  { cúis: Teaghrán }
}