// E114 — this word can't take eclipsis.
//
// The eclipsis twin of E104. "ar" demands lenition, and "gcat" is already
// written in an eclipsed shape the lemma can't carry.
//
// Narrow case: words starting l/m/n/r/s/h have no eclipsed form to write
// at all, so those get E101 instead.

gcat sealadach = 3

gníomh príomh() {
    cuir 1 ar gcat
}