// E113 — unlicensed eclipsis.
//
// Was E108 before 0.13 (outright refusal, since eclipsis had no meaning
// anywhere). Now "i" gives it a slot (§5.2), so the eclipsed form resolves
// to its lemma first, and the real question is whether this position
// licenses eclipsis. "scríobh" doesn't, so this fails — but as a position
// question, not a language one, same improvement E519 made for tense.

baile seasmhach = 3

gníomh príomh() {
    scríobh mbaile
}