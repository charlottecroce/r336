// E510 — tá an ceangal seasmhach.
//
// `seasmhach` i gcoinne `sealadach`: an deighilt idir eisint agus timpiste
// (§13). Ní chuirtear staid ar rud atá seasmhach — ní hé nach bhfuil cead
// agat, ach nach bhfuil sé ina rud a athraíonn.

seasmhach comhaireamh = 0

gníomh príomh() {
    cuir 1 ar chomhaireamh
}
