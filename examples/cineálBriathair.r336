// cineálBriathair.r336 — verb types (§20).
//
// A verb's type is its declaration minus the name, so mood is part of the
// type: `gníomh(T)` and `feidhm(T) -> U` are different types entirely.
//
//     feidhm(Uimhir) -> Uimhir      indicative: returns a value
//     gníomh(Teaghrán)              imperative: returns nothing
//     ag feidhm(Iasacht) -> Bool    ongoing
//
// A gníomh can't be called as an expression (E501), so `déan` is the only
// consumer of a gníomh-typed value: it turns the named noun back into an
// action.

gníomh fógair(t: Teaghrán) { scríobh t }

gníomh faoiDhó(g: gníomh(Teaghrán), liosta: Liosta(Teaghrán)) {
    déan g ar liosta
    déan g ar liosta
}

feidhm dúbail(u: Uimhir) -> Uimhir { u + u }

feidhm cuirIbhFeidhm(f: feidhm(Uimhir) -> Uimhir, u: Uimhir) -> Uimhir {
    f(u)
}

gníomh príomh() {
    faoiDhó a fhógair, ["a", "b"]
    scríobh cuirIbhFeidhm(a dhúbail, 21)
}