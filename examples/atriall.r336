// atriall.r336 — distributing an action over a collection (§21).
//
// `déan <verbal noun> ar <collection>` is the light-verb construction
// ("déan scrúdú ar" = examine); with a plural object it becomes a loop.
// Nothing new grammatically: `déan` is a bare imperative root, `a fhógair`
// the existing nominalising particle, `ar` the same preposition `cuir … ar
// …` uses. Just a lexical fact: `déan` selects `ar`.

struchtúr Duine {
    ainm: Teaghrán
    aois: Uimhir
}

gníomh fógair(duine: Duine) {
    scríobh ainm ó dhuine + " (" + comhaireamh(aois ó dhuine) + ")"
}

feidhm comhaireamh(u: Uimhir) -> Teaghrán {
    má u < 18 { "óg" } mura { "aosta" }
}

gníomh príomh() {
    daoine seasmhach = [
        Duine { ainm: "Cáit", aois: 20 },
        Duine { ainm: "Oisín", aois: 12 },
        Duine { ainm: "Aoife", aois: 34 }
    ]
    déan a fhógair ar dhaoine
}