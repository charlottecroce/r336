// atriall.sb — an gníomh á dháileadh ar bhailiúchán (DEARADH.md §21).
//
// `déan` an briathar éadrom a chuireann gníomh in iúl as ainmfhocal briathartha:
//
//     déan scrúdú ar na cáipéisí     rinne sé iniúchadh orthu
//     déan cur síos ar an áit        déan dearmad air
//
// Ainmníonn an t-ainmfhocal briathartha an gníomh, agus comharthaíonn `ar` an
// rud a ndéantar leis é. Le hiolra, scaiptear an gníomh ar na baill — agus sin
// lúb.
//
// Níl aon rud nua sa ghramadach anseo:
//     déan        fréamh lom an ordaitheach (§17)
//     a fhógair   an cháithnín ainmniúcháin atá sa teanga cheana (§13)
//     ar dhaoine  an réamhfhocal a rialaíonn `cuir … ar …` cheana, agus a
//                 shéimhíonn tríd an gcód céanna (§12)
//
// Níl ann ach fíric fhoclóireachta: roghnaíonn `déan` an réamhfhocal `ar`.

struchtúr Duine {
    ainm: Teaghrán
    aois: Uimhir
}

gníomh fógair(duine: Duine) {
    scríobh ainm ó dhuine + " (" + comhaireamh(aois ó dhuine) + ")"
}

feidhm comhaireamh(u: Uimhir) -> Teaghrán {
    má u < 18 { "óg" } mura { "aosta" }
}

gníomh príomh() {
    daoine seasmhach = [
        Duine { ainm: "Cáit", aois: 20 },
        Duine { ainm: "Oisín", aois: 12 },
        Duine { ainm: "Aoife", aois: 34 }
    ]
    déan a fhógair ar dhaoine
}
