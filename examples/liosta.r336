// liosta.r336 — heterogeneous lists and meeting at a sum (§26.5, §26.7).
//
// E211 was briefly made real in 0.8 and made unreachable again the same
// release: `[ainm, aois]` at a driver boundary is a legitimate mixed list
// with no sum to cover it. Reserved, no case file. Here's what happens
// instead.

// 1. WIDEN. No common type among these items, so the list widens to
//    Liosta(Iasacht) — not an error.
measctha seasmhach = [1, "a dó", 3]
scríobh fad ó mheasctha

// 2. MEET. Two variants of the same sum have a common type (the sum
//    itself), so the list meets at Toradh instead of widening to Iasacht.
suim Toradh {
    Ceart  { luach: Uimhir }
    Easpa  { cúis: Teaghrán }
}

torthaí seasmhach: Liosta(Toradh) = [
    Ceart { luach: 1 },
    Easpa { cúis: "Gan aimsiú" }
]

feidhm tuairisc(toradh: Toradh) -> Teaghrán {
    más Ceart toradh { "ceart" } mura { cúis ó thoradh }
}

gníomh luaigh(toradh: Toradh) {
    scríobh tuairisc(toradh)
}

gníomh príomh() {
    déan a luaigh ar thorthaí
}