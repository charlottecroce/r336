// dochar.r336 — `ar` as an adverse state (§39).
//
// Irish has no verb "to have" or "to fail"; misfortune is put ON you: "tá
// tinneas cinn orm" (headache), "theip orm" (I failed). Of three related
// idioms (ag/le/ar), only "ar" can be built without pronouns (§32.6),
// which is why only it gets language support.
//
// Not all of this is Irish grammar and that's stated plainly: `ar` itself
// lenites through the existing `reitighFoirm` mechanism (no new
// morphology), but the feature is grounded in semantics rather than form —
// same treatment `suim` got in §26.1.

as Corcaigh

// The adverse type claims a province like any other placed type. No
// exception: it's a type, and there are four slots.
struchtúr Earráid as Corcaigh {
    cúis: Teaghrán
}

// "-> Uimhir ar Earráid": returns a Uimhir that may instead be an Earráid.
// Not a sum; the caller only has to rule out what the signature named.
feidhm roinn(uachtar: Uimhir, íochtar: Uimhir) -> Uimhir ar Earráid {
    má íochtar == 0 {
        Earráid { cúis: "ní roinntear ar nialas" }
    } mura {
        uachtar / íochtar
    }
}

// Both branches meet at the afflicted type, same as two sum variants
// meeting at the sum (§26.5). No constructor needed, widening is free.

// "tá Earráid ar …" — the substantive verb, agreeing with its particle as
// always: tá under má, bhfuil under mura.
gníomh luaigh(uachtar: Uimhir, íochtar: Uimhir) {
    toradh seasmhach = roinn(uachtar, íochtar)
    má tá Earráid ar thoradh {
        // Here toradh is an Earráid, with a field.
        scríobh "theip air: " + cúis ó thoradh
    } mura {
        // And here it's a plain Uimhir.
        scríobh toradh
    }
}

// The dependent form, as always under mura.
feidhm slán(toradh: Uimhir ar Earráid) -> Bool {
    mura bhfuil Earráid ar thoradh { fíor } mura { bréagach }
}

gníomh príomh() {
    luaigh 10, 2
    luaigh 10, 0
}