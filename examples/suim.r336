// suim.r336 — sum types (§26).
//
//   INTRODUCTION  `Ceart { duine: … }` — an ordinary struct literal, no new
//                 syntax. Free widening: Ceart already is a Toradh.
//
//   ELIMINATION   `más Ceart t` — the copula classifies, and the branch
//                 knows the answer for its duration. This half is grounded
//                 in Irish grammar.
//
//   PROVINCE      The sum claims a province; no variant claims one of its
//                 own, so a sum never costs two slots.

as Corcaigh

struchtúr Duine as Corcaigh {
    ainm: Teaghrán
    aois: Uimhir
}

// The sum is in Connachta, Duine in An Mhumhain, so opening the payload
// needs a treaty. The payload is still a placed type.
comhaontú Corcaigh Gaillimh

suim Toradh as Gaillimh {
    Ceart  { duine: Duine }
    Easpa  { cúis: Teaghrán }
}

// Neamhní expresses absence now, not Iasacht — Iasacht in a variant field
// is E213 (§26.4).
feidhm tuairisc(toradh: Toradh) -> Teaghrán {
    más Ceart toradh { ainm ó dhuine ó thoradh } mura { cúis ó thoradh }
}

// Both branches meet at the sum; giving Ceart in one and Easpa in the
// other isn't a type error.
feidhm cuardaigh(aois: Uimhir) -> Toradh {
    má aois > 17 { Ceart { duine: Duine { ainm: "Cáit", aois: aois } } }
    mura { Easpa { cúis: "Ró-óg" } }
}

// A mixed list now has somewhere to go — why E211 is finally reachable
// (§26.5).
torthaí seasmhach: Liosta(Toradh) = [
    Ceart { duine: Duine { ainm: "Síle", aois: 30 } },
    Easpa { cúis: "Gan aimsiú" }
]

gníomh luaigh(toradh: Toradh) {
    scríobh tuairisc(toradh)
}

gníomh príomh() {
    déan a luaigh ar thorthaí
    scríobh tuairisc(cuardaigh(20))
    scríobh tuairisc(cuardaigh(9))
}