// ainmniú.r336 — the verb as noun (§18, §20).
//
// `ag <ainm bhriathartha>` marks ongoing action; `a <ainm bhriathartha>`
// names the verb as a value (a closure). They're distinct in Irish too, so
// there's no conflict. `a` lenites its complement, same rule as `ó`/`ar`.
//
// Not the vocative `a` (§20) — Irish has two: one to address someone, one
// to nominalise a verb. This is the second; nothing is being called.

bun seasmhach = ó "../rt/bunúsach.js"

gníomh fógair(mír: Iasacht) {
    scríobh "  • " + téacs ó bhun(mír)
}

gníomh trom(mír: Iasacht) {
    scríobh "  ── " + téacs ó bhun(mír)
}

gníomh príomh() {
    // `forEach` is a borrowed member: keeps its borrowed name.
    liosta seasmhach: Iasacht = ["Cáit", "Oisín", "Aoife"]

    scríobh "gnáth:"
    forEach ó liosta(a fhógair)

    scríobh "trom:"
    forEach ó liosta(a throm)
}