// modhanna.r336 — methods as functions attached to a category.
//
// `feidhm ainm ó Dhuine(féin)`: `ó` lenites `Duine` here exactly as it does
// in an expression — one rule, not two.

struchtúr Duine {
    ainm: Teaghrán
    aois: Uimhir
}

feidhm beannacht ó Dhuine(féin) -> Teaghrán {
    "Dia duit, " + ainm ó fhéin
}

feidhm aosta ó Dhuine(féin) -> Bool {
    aois ó fhéin >= 18
}

// A method with arguments beyond the receiver.
feidhm aoisAmachAnseo ó Dhuine(féin, blianta: Uimhir) -> Uimhir {
    aois ó fhéin + blianta
}

duine seasmhach = Duine { ainm: "Charlotte", aois: 20 }

// At the call site, the same relation: "beannacht ó dhuine".
scríobh beannacht ó dhuine()
scríobh aosta ó dhuine()
scríobh aoisAmachAnseo ó dhuine(5)