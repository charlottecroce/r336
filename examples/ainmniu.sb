// ainmniú.sb — an briathar ina ainmfhocal (§18, §20).
//
// Bhí teannas ann i gcéim 0.3: is é `ag` + ainm briathartha an fhoirm
// Ghaeilge don ghníomh atá ar siúl (gealltanas) AGUS don ghníomh mar rud
// (clabhsúr). Tá an teannas réitithe anois, mar nach ionann an dá rud sa
// Ghaeilge ach an oiread:
//
//   ag scríobh    an cháithnín aspectach + an t-ainm briathartha : ar siúl
//   a scríobh     an cháithnín ainmniúcháin + an t-ainm briathartha : an rud
//
// Séimhíonn `a` a chomhlánú, mar a dhéanann `ó` agus `ar`. Sin an tríú
// hoibreoir a rialaíonn foirm, agus an riail chéanna i ngach cás.
//
// NÍ hé seo an tuiseal gairmeach (§20): tá an cháithnín `a` ann faoi dhó sa
// Ghaeilge — ceann chun duine a ghairm, ceann chun briathar a ainmniú — agus
// is é an dara ceann atá anseo. Ní ghlaotar ar aon rud leis.

seasmhach bun = ó "../rt/bunúsach.js"

gníomh fógair(mír: Iasacht) {
    scríobh "  • " + téacs ó bhun(mír)
}

gníomh trom(mír: Iasacht) {
    scríobh "  ── " + téacs ó bhun(mír)
}

gníomh príomh() {
    // `forEach` is ball ar iasacht: coinníonn sé a ainm iasachta.
    seasmhach liosta: Iasacht = ["Cáit", "Oisín", "Aoife"]

    scríobh "gnáth:"
    forEach ó liosta(a fhógair)

    scríobh "trom:"
    forEach ó liosta(a throm)
}
